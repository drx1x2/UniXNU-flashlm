--- a/DarwinBootPkg/Driver/DarwinBoot.c
+++ b/DarwinBootPkg/Driver/DarwinBoot.c
@@ -720,6 +720,17 @@
     DiagDraw (ProgLine, 5);
     ZeroMem ((VOID *)(UINTN)ProgAddress, 0x18);
   }
+  //
+  // flashlm M3Z (UniXNU-flashlm patches/darwinboot-readback-hold.patch):
+  // hold the readback rows 2-6 (WIN, EXC/ELR, PROG, PRB) on screen for
+  // 10 s before the window ZeroMem and hand-off. Since M3W the kernel
+  // reaches initialize_screen, which repaints the framebuffer, so the
+  // rows drawn here no longer persist into a photo of the frozen screen;
+  // and the EXC/PROG records are consumed (ZeroMem) on this boot, so the
+  // only chance to see them is this frame. DIAGNOSTIC ONLY.
+  //
+  DiagDraw (L"HOLD 10S", 12);
+  gBS->Stall (10 * 1000 * 1000);
   ArgsAddress = ALIGN_VALUE (Address + Kernel.End - Kernel.Base, SIZE_16KB);
   TreeAddress = ArgsAddress + EFI_PAGE_SIZE;
   RamdiskAddress = ALIGN_VALUE (TreeAddress + TreeSize, EFI_PAGE_SIZE);
