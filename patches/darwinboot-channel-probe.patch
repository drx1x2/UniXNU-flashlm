     DiagDraw (ProgLine, 5);
     ZeroMem ((VOID *)(UINTN)ProgAddress, 0x18);
   }
+  //
+  // flashlm M3H (UniXNU-flashlm patches/firmware-channel-probe.md):
+  // out-of-window record-channel probes, read with the rest of the
+  // readback block (before the window ZeroMem below). The M3G verdict
+  // (PRB NO with PROG NONE on hardware) proved the in-window record
+  // page does not survive a forced power-cycle reboot on this
+  // device, so two window-independent candidates are tested: SLT =
+  // the BootShim reserved slot page at 0x89B00100 (BootShim writes
+  // only +0x00 there and UniXNURamDiskDxe reads only +0x00; this
+  // driver is the only user of +0x100), and VAR = a non-volatile
+  // UEFI variable in the platform variable store. The companion
+  // writes sit at the bottom of Boot next to the PRB write. Row 7
+  // is always drawn; a matching magic means the previous boot's
+  // write survived the reboot. Every error path degrades silently
+  // to NO and never affects the boot flow.
+  //
+  {
+    volatile UINT64  *Slt;
+    UINT64            VarValue;
+    UINTN             VarSize;
+    EFI_STATUS        VarStatus;
+    CHAR16            ChanLine[64];
+
+    Slt = (volatile UINT64 *)(UINTN)0x89B00100;
+    VarValue = 0;
+    VarSize = sizeof (VarValue);
+    VarStatus = EFI_NOT_FOUND;
+    if ((gRT != NULL) && (gRT->GetVariable != NULL)) {
+      VarStatus = gRT->GetVariable (L"M3Probe", (EFI_GUID *)&mM3ProbeVariableGuid, NULL, &VarSize, &VarValue);
+    }
+
+    UnicodeSPrint (ChanLine, sizeof (ChanLine), L"SLT %s VAR %s",
+                   (*Slt == 0x534C5431ULL) ? L"OK" : L"NO",
+                   (!EFI_ERROR (VarStatus) && (VarSize == sizeof (UINT64)) && (VarValue == 0x56415231ULL)) ? L"OK" : L"NO");
+    DiagDraw (ChanLine, 7);
+  }
   ArgsAddress = ALIGN_VALUE (Address + Kernel.End - Kernel.Base, SIZE_16KB);
   TreeAddress = ArgsAddress + EFI_PAGE_SIZE;
   RamdiskAddress = ALIGN_VALUE (TreeAddress + TreeSize, EFI_PAGE_SIZE);
@@ -812,6 +856,25 @@
   // tail for the next boot's readback to find.
