+STATIC CONST EFI_GUID  mM3ProbeVariableGuid = { 0x8d0451b3, 0xadd8, 0x4e53, { 0x81, 0x97, 0xd7, 0x84, 0x6a, 0xe1, 0x41, 0x31 } };
