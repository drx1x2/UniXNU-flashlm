   *(volatile UINT64 *)(UINTN)(ArgsAddress + 0x860) = 0x50524231ULL;
+  //
+  // flashlm M3H: companion writes for the SLT/VAR channel readback
+  // above (same placement as the PRB write: after this boot's
+  // window fills, before DarwinEnter). The slot write goes to the
+  // BootShim reserved page outside the window; the variable write
+  // targets the platform variable store. Fire-and-forget: a failed
+  // SetVariable is ignored by design.
+  //
+  {
+    UINT64  VarMagic;
+
+    *(volatile UINT64 *)(UINTN)0x89B00100 = 0x534C5431ULL;
+    VarMagic = 0x56415231ULL;
+    if ((gRT != NULL) && (gRT->SetVariable != NULL)) {
+      (VOID)gRT->SetVariable (L"M3Probe", (EFI_GUID *)&mM3ProbeVariableGuid,
+                              EFI_VARIABLE_NON_VOLATILE | EFI_VARIABLE_BOOTSERVICE_ACCESS | EFI_VARIABLE_RUNTIME_ACCESS,
+                              sizeof (VarMagic), &VarMagic);
+    }
+  }
