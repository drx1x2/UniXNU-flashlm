+    CrumbAddress = ALIGN_VALUE (Address + Kernel.End - Kernel.Base, SIZE_16KB) + 0x800;
+    Crumb = (volatile UINT64 *)(UINTN)CrumbAddress;
+    if ((Crumb[0] == 0x4D33455843524D31ULL) && (Crumb[8] == 0x4D33455843524D32ULL)) {
+      CHAR16  ExcLine[64];
+      CHAR16  ElrLine[64];
+
+      UnicodeSPrint (ExcLine, sizeof (ExcLine), L"EXC %lx ESR %lx", Crumb[4], Crumb[1]);
+      UnicodeSPrint (ElrLine, sizeof (ElrLine), L"ELR %lx FAR %lx", Crumb[2], Crumb[3]);
+      DiagDraw (ExcLine, 3);
+      DiagDraw (ElrLine, 4);
+      ZeroMem ((VOID *)(UINTN)CrumbAddress, 0x48);
+    }
+  }
