+  // flashlm M3G (UniXNU-flashlm patches/darwinboot-crumb-readback.patch):
+  // survival probe, read first in the readback block. Each boot that
+  // reaches the hand-off preparations writes the probe magic into the
+  // boot-args page tail (ArgsAddress + 0x860, past the EXC record and
+  // the PROG slot, which the kernel never writes) after the window
+  // ZeroMem below; on the next boot the value found here tells whether
+  // anything in this page survives a reboot at all (forced power-cycle
+  // included). Row 6 is always drawn, separately from the PROG row:
+  // 'PRB OK' = the previous boot's write survived, 'PRB NO' = the
+  // cross-boot record channel itself is broken on this device.
+  //
+  {
+    UINTN               ProbeAddress;
+    volatile UINT64     *Probe;
+
+    ProbeAddress = ALIGN_VALUE (Address + Kernel.End - Kernel.Base, SIZE_16KB) + 0x860;
+    Probe = (volatile UINT64 *)(UINTN)ProbeAddress;
+    DiagDraw ((*Probe == 0x50524231ULL) ? L"PRB OK" : L"PRB NO", 6);
+  }
+  //
+  // flashlm M3E (UniXNU-flashlm patches/darwinboot-crumb-readback.patch):
+  // exception black-box readback. The M3E diagnostic kernel records an
+  // early exception into the tail of the boot-args page (ArgsAddress +
+  // 0x800, past the 0x480-byte DARWIN_BOOT_ARGS) and resets via PSCI;
+  // DRAM contents survive the reset, so on this boot the record left by
+  // a crashed previous boot still sits in the freshly allocated window
+  // (same size, same landing) and must be read before the window
+  // ZeroMem below wipes it. Read-only unless both magics match: a match
+  // draws the record on DiagDraw rows 3-4 and clears it.
+  //
+  {
+    UINTN               CrumbAddress;
+    volatile UINT64     *Crumb;
