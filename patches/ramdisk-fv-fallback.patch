@@ -128,13 +146,61 @@ STATIC EFI_BLOCK_IO_PROTOCOL  mBlockIo = {
   RamBlockFlush
 };
 
+STATIC BOOLEAN  mPublished = FALSE;
+
+STATIC
+BOOLEAN
+PublishRange (
+  IN UINT64  Start,
+  IN UINT64  End
+  )
+{
+  EFI_STATUS  Status;
+  EFI_HANDLE  Handle;
+
+  if (mPublished || (End <= Start) || (((End - Start) % RAM_BLOCK_SIZE) != 0)) {
+    return mPublished;
+  }
+
+  mRamBase                = (UINT8 *)(UINTN)Start;
+  mMedia.MediaId          = 1;
+  mMedia.RemovableMedia   = FALSE;
+  mMedia.MediaPresent     = TRUE;
+  //
+  // The payload is a FAT volume image, not a partitioned disk. Mark it as a
+  // logical partition so PartitionDxe skips it and FatDxe binds directly
+  // (same treatment as ShengBootMemoryDxe's publisher).
+  //
+  mMedia.LogicalPartition = TRUE;
+  mMedia.ReadOnly         = TRUE;
+  mMedia.WriteCaching     = FALSE;
+  mMedia.BlockSize        = RAM_BLOCK_SIZE;
+  mMedia.IoAlign          = 1;
+  mMedia.LastBlock        = (End - Start) / RAM_BLOCK_SIZE - 1;
+
+  Handle = NULL;
+  Status = gBS->InstallMultipleProtocolInterfaces (
+                  &Handle,
+                  &gEfiDevicePathProtocolGuid,
+                  &mDevicePath,
+                  &gEfiBlockIoProtocolGuid,
+                  &mBlockIo,
+                  NULL
+                  );
+  DEBUG ((DEBUG_ERROR, "UNIXNURAMDISK: block device 0x%lx size 0x%lx %r\n", Start, End - Start, Status));
+  if (!EFI_ERROR (Status)) {
+    mPublished = TRUE;
+  }
+
+  return mPublished;
+}
