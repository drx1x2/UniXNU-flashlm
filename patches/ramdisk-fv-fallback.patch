+//
+// flashlm fallback: fetch the payload image out of the firmware volume and
+// publish it exactly like an initrd. GetSectionFromAnyFv() returns a pool
+// buffer owned by the caller; it is deliberately never freed, because the
+// block device reads from it for the rest of the boot session.
+//
+STATIC
+BOOLEAN
+PublishFvPayload (
+  VOID
+  )
+{
+  EFI_STATUS  Status;
+  VOID        *Buffer;
+  UINTN       Size;
+
+  Buffer = NULL;
+  Size   = 0;
+  Status = GetSectionFromAnyFv (
+             &mPayloadFileGuid,
+             EFI_SECTION_RAW,
+             0,
+             &Buffer,
+             &Size
+             );
+  if (EFI_ERROR (Status) || (Buffer == NULL) || (Size == 0)) {
+    DEBUG ((DEBUG_ERROR, "UNIXNURAMDISK: no FV payload section %r\n", Status));
+    return FALSE;
+  }
+
+  if ((Size % RAM_BLOCK_SIZE) != 0) {
+    DEBUG ((DEBUG_ERROR, "UNIXNURAMDISK: FV payload size 0x%lx is not a whole number of sectors\n", (UINT64)Size));
+    return FALSE;
+  }
+
+  DEBUG ((DEBUG_ERROR, "UNIXNURAMDISK: FV payload at %p size 0x%lx\n", Buffer, (UINT64)Size));
+  return PublishRange ((UINT64)(UINTN)Buffer, (UINT64)(UINTN)Buffer + Size);
 }
 
