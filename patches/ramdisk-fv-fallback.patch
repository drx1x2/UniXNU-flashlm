   0xDAEE82E6, 0x8090, 0x4E72, { 0xBF, 0xB9, 0x78, 0xC1, 0x3C, 0xD4, 0xE3, 0x59 }
 };
 
+// FFS file GUID of the FV-carried payload image (payload.img, a FAT12
+// volume). flashlm: UniXNU-flashlm/NOTES.md and the mh2lm B1 record only
+// preserve the 7E2B4C1A prefix of the GUID mh2lm used in its (unpublished)
+// 0016-fv-payload patch; the remaining fields are chosen by this port and
+// must match the FILE FREEFORM GUID in the device FDF include (DXE.inc).
+// Only the FDF/driver pair has to agree for the fallback to work.
+STATIC CONST EFI_GUID mPayloadFileGuid = {
+  0x7E2B4C1A, 0x9B8C, 0x4D2E, { 0xA1, 0xF0, 0x46, 0x4C, 0x41, 0x53, 0x48, 0x00 }
+};
