flashlm: slot DTB source for UniXNURamDiskDxe (M2G)

Writer/reader pair that repairs the initrd handoff the ramdisk probe
exposed: this firmware's classic AndromedaPkg PrePi never converts the
ABL's x0 into the UniXNU entry-argument HOB (DAEE82E6), so the upstream
HOB path in UniXNURamDiskDxe can never fire and a boot-image ramdisk is
unreachable (probe image booted to the built-in menu with an empty FV).

  * BootShim/BootShim.S (aloha lg-flash tree): _Start stores x0 at
    0x89B00000 -- head of the reserved "RAM Partition" region in the
    lg-flash memory map (PlatformMemoryMapLib.c), the same slot this
    port once picked for ShengBootMemoryDxe -- using the movz/movk
    pattern of the guacamole BootShim patch (address changed to this
    board's value). BootShim must be rebuilt after this change
    (build_boot_shim.sh -b 0x9FC00000 -s 0x00300000).
  * UniXNURamDiskDxe: source chain becomes HOB -> slot -> FV payload.
    The slot read validates with the same FdtCheckHeader check as the
    HOB path and reuses PublishInitrd(); every failure returns FALSE
    and falls through to the FV payload (never EFI_COMPROMISED_DATA).

Relationship to ramdisk-fv-fallback.patch: STACKED. This patch applies
on top of the FV-fallback fork state (its hunks do not overlap that
patch's hunks) and extends the source chain that patch created.

diff --git a/BootShim/BootShim.S b/BootShim/BootShim.S
index 76dcb4f9..6d11adcc 100644
--- a/BootShim/BootShim.S
+++ b/BootShim/BootShim.S
@@ -34,6 +34,15 @@ _StackSize:
 	.long 0
 
 _Start:
+	/* Preserve the device-tree pointer for UniXNURamDiskDxe.
+	   The classic AndromedaPkg PrePi in this firmware never turns x0
+	   into the UniXNU entry-argument HOB, so stash x0 at 0x89B00000,
+	   the head of the reserved "RAM Partition" region in the lg-flash
+	   memory map (PlatformMemoryMapLib.c). x6 is safe to clobber:
+	   _Start reloads it from _StackSize before the copy loop. */
+	movz	x6, #0x0000
+	movk	x6, #0x89B0, lsl #16
+	str		x0, [x6]
 	mov		x4, x1
 	ldr		x5, _StackBase
 	cmp		x4, x5
--- a/package/UniXNUPkg/Driver/UniXNURamDiskDxe/UniXNURamDiskDxe.c
+++ b/package/UniXNUPkg/Driver/UniXNURamDiskDxe/UniXNURamDiskDxe.c
@@ -8,6 +8,14 @@
   the boot image's ramdisk. The FDT path is unchanged and always wins when
   it produces a device.
 
+  flashlm (LG V50) slot addition: the classic AndromedaPkg PrePi in this
+  firmware never converts the ABL's x0 into the entry-argument HOB below
+  (that HOB is a Mu-Silicium SEC convention), so the HOB path can never
+  fire here and a boot-image ramdisk would be unreachable. BootShim.S
+  therefore stores x0 at a fixed slot (0x89B00000) before jumping into
+  the FD; this driver tries, in order: the HOB, the slot, then the FV
+  payload. Any slot validation failure falls through to the FV payload.
+
   SPDX-License-Identifier: BSD-2-Clause
 **/
 
@@ -27,6 +35,16 @@
   0xDAEE82E6, 0x8090, 0x4E72, { 0xBF, 0xB9, 0x78, 0xC1, 0x3C, 0xD4, 0xE3, 0x59 }
 };
 
+// flashlm: BootShim.S stores the ABL's x0 (device tree pointer) at this
+// fixed address before jumping into the FD, because this firmware's
+// PrePi never produces the entry-argument HOB above. 0x89B00000 is the
+// head of the reserved "RAM Partition" region in the lg-flash memory
+// map (PlatformMemoryMapLib.c); it is the same slot this port once
+// picked for ShengBootMemoryDxe, and reserved memory is never handed
+// out by the DXE allocator, so the value survives until this driver
+// runs.
+#define DTB_POINTER_SLOT  0x89B00000
+
 // FFS file GUID of the FV-carried payload image (payload.img, a FAT12
 // volume). flashlm: UniXNU-flashlm/NOTES.md and the mh2lm B1 record only
 // preserve the 7E2B4C1A prefix of the GUID mh2lm used in its (unpublished)
@@ -235,6 +253,36 @@
 }
 
 //
+// flashlm slot source: recover the device tree pointer BootShim.S stored
+// at DTB_POINTER_SLOT and publish its /chosen initrd exactly like the HOB
+// path. Every validation failure returns FALSE so the caller falls
+// through to the FV payload; unlike the HOB branch above, nothing here
+// may compromise the entry point.
+//
+STATIC
+BOOLEAN
+PublishSlotInitrd (
+  VOID
+  )
+{
+  UINT64  Dtb;
+
+  Dtb = ReadUnaligned64 ((CONST UINT64 *)(UINTN)DTB_POINTER_SLOT);
+  if (Dtb == 0) {
+    DEBUG ((DEBUG_ERROR, "UNIXNURAMDISK: no device tree pointer in slot\n"));
+    return FALSE;
+  }
+
+  if (((Dtb & 3) != 0) || (FdtCheckHeader ((VOID *)(UINTN)Dtb) != 0)) {
+    DEBUG ((DEBUG_ERROR, "UNIXNURAMDISK: slot value 0x%lx is not a device tree\n", Dtb));
+    return FALSE;
+  }
+
+  DEBUG ((DEBUG_ERROR, "UNIXNURAMDISK: device tree at 0x%lx (slot), %u bytes\n", Dtb, (UINT32)FdtTotalSize ((VOID *)(UINTN)Dtb)));
+  return PublishInitrd ((VOID *)(UINTN)Dtb);
+}
+
+//
 // flashlm fallback: fetch the payload image out of the firmware volume and
 // publish it exactly like an initrd. GetSectionFromAnyFv() returns a pool
 // buffer owned by the caller; it is deliberately never freed, because the
@@ -302,6 +350,10 @@
   }
 
   if (!Published) {
+    Published = PublishSlotInitrd ();
+  }
+
+  if (!Published) {
     PublishFvPayload ();
   }
 
