+STATIC
+UINT64
+M3PPsciCpuOn (
+  IN UINT64  TargetMpidr,
+  IN UINT64  EntryPoint,
+  IN UINT64  ContextId
+  )
+{
+  register UINT64  X0 __asm__ ("x0") = M3P_PSCI_CPU_ON;
+  register UINT64  X1 __asm__ ("x1") = TargetMpidr;
+  register UINT64  X2 __asm__ ("x2") = EntryPoint;
+  register UINT64  X3 __asm__ ("x3") = ContextId;
+
+  __asm__ volatile (
+    "smc #0\n"
+    : "+r" (X0)
+    : "r" (X1), "r" (X2), "r" (X3)
+    : "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13",
+      "x14", "x15", "x16", "x17", "memory"
+    );
+  return X0;
+}
+
+STATIC EFI_STATUS ReadBootVideo (UINT64 Video[6]);
+
+//
+// M3U degradation path: without page tables there is no monitor,
+// so paint the row-3 idx0 block black directly, in the same
+// framebuffer geometry the blob paints (FB base and row bytes
+// from the GOP, exactly as DiagDraw reads them; the block is
+// x [0,240), y [2940,3000) on this panel). Fire-and-forget: if
+// the video facts cannot be read, the boot proceeds unpainted.
+//
+STATIC
+VOID
+M3UDegradedPaintIdx0Black (
+  VOID
+  )
+{
+  UINT64  Video[6];
+  UINT32  *Fb;
+  UINTN   X, Y;
+
+  if (EFI_ERROR (ReadBootVideo (Video)) || (Video[0] == 0) || (Video[2] == 0)) {
+    return;
+  }
+
+  Fb = (UINT32 *)(UINTN)Video[0];
+  for (Y = 2940; Y < 3000; Y++) {
+    for (X = 0; X < 240; X++) {
+      Fb[Y * (Video[2] / 4) + X] = 0xFF000000;
+    }
+    //
+    // M3U2: idx4 (x [1040,1280)) purple = "allocation failed, no
+    // launch" -- the blob's own idx4 stage markers (white / magenta /
+    // gray / green) can then never be confused with this path.
+    //
+    for (X = 1040; X < 1280; X++) {
+      Fb[Y * (Video[2] / 4) + X] = 0xFF800080;
+    }
+  }
+}
+
+STATIC
+VOID
+M3PLaunchMonitor (
+  OUT UINT64  *Result
+  )
+{
+  EFI_STATUS            Status;
+  EFI_PHYSICAL_ADDRESS  TablePages;
+  UINTN                 Index;
+
+  //
+  // flashlm M3U: allocate the monitor's page-table pages and hand
+  // their base PA to the blob through the slot-page cell. On
+  // failure, degrade as described above -- never block the boot.
+  //
+  Status = gBS->AllocatePages (AllocateAnyPages, EfiLoaderData, M3U_TABLE_PAGES, &TablePages);
+  if (EFI_ERROR (Status)) {
+    M3UDegradedPaintIdx0Black ();
+    *Result = 0xFFFFFFFFFFFFFFFFULL;
+    return;
+  }
+
+  *(volatile UINT64 *)(UINTN)M3U_TABLE_PA_CELL = (UINT64)TablePages;
+
+  //
+  // M3U2: the blob writes these pages with its MMU off (straight to
+  // DRAM) and then walks them with cacheable walks. Clean+invalidate
+  // them here, before the launch, so no stale or dirty line of a
+  // previous owner sits in this core's caches (or the shared L3) to
+  // be snooped by the walker or written back over the tables later.
+  // This core never touches the pages again.
+  //
+  for (Index = 0; Index < M3U_TABLE_PAGES * EFI_PAGE_SIZE; Index += 64) {
+    __asm__ volatile ("dc civac, %0" :: "r" ((UINTN)TablePages + Index) : "memory");
+  }
+
+
+  //
+  // flashlm M3V: zero the trace ring (args page +0x980..+0x9FF, PA
+  // 0xC1F14980; audited unused by every other channel) so no fossil
+  // of an earlier boot is drawn, and push the zeros to DRAM -- the
+  // kernel's trace stubs append to it, the blob only reads it.
+  //
+  ZeroMem ((VOID *)(UINTN)M3V_TRACE_RING_PA, M3V_TRACE_RING_SIZE);
+  for (Index = 0; Index < M3V_TRACE_RING_SIZE; Index += 64) {
+    __asm__ volatile ("dc civac, %0" :: "r" ((UINTN)M3V_TRACE_RING_PA + Index) : "memory");
+  }
+
+  CopyMem ((VOID *)(UINTN)M3P_MONITOR_RESIDENT, mM3PMonitorBlob, sizeof (mM3PMonitorBlob));
+  //
+  // The woken core fetches the blob and reads the table-PA cell
+  // with its caches off: clean both ranges to the point of
+  // coherency before the CPU_ON.
+  //
+  for (Index = 0; Index < sizeof (mM3PMonitorBlob); Index += 64) {
+    __asm__ volatile ("dc cvac, %0" :: "r" ((UINTN)M3P_MONITOR_RESIDENT + Index) : "memory");
+  }
+
+  __asm__ volatile ("dc cvac, %0" :: "r" ((UINTN)M3U_TABLE_PA_CELL) : "memory");
+  __asm__ volatile ("dsb sy\n" ::: "memory");
+  __asm__ volatile ("isb\n" ::: "memory");
+  *Result = M3PPsciCpuOn (M3P_TARGET_MPIDR, M3P_MONITOR_RESIDENT, 0);
 }
 
