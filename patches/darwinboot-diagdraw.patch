diff --git a/DarwinBootPkg/Driver/DarwinBoot.c b/DarwinBootPkg/Driver/DarwinBoot.c
--- a/DarwinBootPkg/Driver/DarwinBoot.c
+++ b/DarwinBootPkg/Driver/DarwinBoot.c
@@ -404,6 +404,24 @@
   }
 }
 
+//
+// flashlm bring-up black box (UniXNU-flashlm patches/darwinboot-diagdraw.patch):
+// on a boot failure, draw "DB <stage> <what> <status>" on a stage-owned
+// framebuffer row and hold it for 15 s, so it can be photographed before the
+// caller redraws over the console. Success paths never call this.
+//
+STATIC
+VOID
+DbFail (UINTN Stage, CONST CHAR16 *What, EFI_STATUS Status)
+{
+  CHAR16 Line[64];
+
+  UnicodeSPrint (Line, sizeof (Line), L"DB %u %s %r", (UINT32)Stage, What, Status);
+  DiagDraw (Line, Stage);
+  Print (L"%s\n", Line);
+  gBS->Stall (15 * 1000 * 1000);
+}
+
 STATIC
 EFI_STATUS
 AllocateWindow (KERNEL *Kernel, UINT64 WindowSize, EFI_PHYSICAL_ADDRESS *Address)
@@ -512,6 +530,7 @@
 
   (VOID)This;
   if ((Request == NULL) || (Request->Volume == NULL) || (Request->KernelPath == NULL)) { return EFI_INVALID_PARAMETER; }
+  DiagDraw (L"DB 0 ENTER", 0);
   if ((Request->KextCount != 0) || (Request->DeviceTree != NULL) || (Request->DeviceTreeSize != 0) ||
