+//
+// The menu's keyboard is every SimpleTextIn instance in the system, not
+// just gST->ConIn. Upstream reads ConIn only, but on platforms where the
+// console splitter never aggregates a producer -- Qualcomm ButtonsDxe
+// installs SimpleTextIn on its own handle for the MsButtonServices front
+// page, and ConSplitter never picks it up -- the physical buttons then
+// exist yet the menu can never see them. Enumerating the protocol finds
+// them all; the splitter handle carries the protocol too, so ConIn is
+// simply one entry of the list and needs no special case.
+//
+#define MAX_TEXT_INPUTS  16
+
+STATIC
+UINTN
+CollectTextInputs (
+  OUT EFI_SIMPLE_TEXT_INPUT_PROTOCOL  **Inputs,
+  IN  UINTN                           Capacity
+  )
+{
+  EFI_STATUS  Status;
+  EFI_HANDLE  *Handles;
+  UINTN       HandleCount;
+  UINTN       Index;
+  UINTN       Count;
+
+  Status = gBS->LocateHandleBuffer (ByProtocol, &gEfiSimpleTextInProtocolGuid, NULL, &HandleCount, &Handles);
+  if (EFI_ERROR (Status)) {
+    return 0;
+  }
+
+  Count = 0;
+  for (Index = 0; (Index < HandleCount) && (Count < Capacity); Index++) {
+    EFI_SIMPLE_TEXT_INPUT_PROTOCOL  *Input;
+
+    if (!EFI_ERROR (gBS->HandleProtocol (Handles[Index], &gEfiSimpleTextInProtocolGuid, (VOID **)&Input)) &&
+        (Input != NULL))
+    {
+      Inputs[Count++] = Input;
+    }
+  }
+
+  FreePool (Handles);
+  return Count;
+}
+
+//
+// Wait until any of the inputs has a key, then read it from the input
+// that signaled. A signaled input whose queue turns out empty just waits
+// again, matching the caller's previous read-and-continue behaviour.
+//
+STATIC
+EFI_STATUS
+WaitAnyKey (
+  IN  EFI_SIMPLE_TEXT_INPUT_PROTOCOL  **Inputs,
+  IN  UINTN                           Count,
+  OUT EFI_INPUT_KEY                   *Key
+  )
+{
+  EFI_EVENT   Events[MAX_TEXT_INPUTS];
+  UINTN       Index;
+  EFI_STATUS  Status;
+
+  for ( ; ;) {
+    for (Index = 0; Index < Count; Index++) {
+      Events[Index] = Inputs[Index]->WaitForKey;
+    }
+
+    Status = gBS->WaitForEvent (Count, Events, &Index);
+    if (EFI_ERROR (Status)) {
+      return Status;
+    }
+
+    Status = Inputs[Index]->ReadKeyStroke (Inputs[Index], Key);
+    if (!EFI_ERROR (Status)) {
+      return Status;
+    }
+  }
+}
